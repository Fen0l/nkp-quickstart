#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

#------------------------------------------------------------------------------

# Downloads the NKP Air-Gapped Bundle and extract

#------------------------------------------------------------------------------

BUNDLE_DIR="./nkp-airgap-bundle"
BUNDLE_FILE="nkp-air-gapped-bundle.tar.gz"

# Prompt the user for the download link
echo 'open browser to site : https://portal.nutanix.com/page/downloads?product=nkp and find "NKP Air-Gapped Bundle for Linux" '
read -p "Enter 'NKP Air-Gapped Bundle for Linux' download link: " url < /dev/tty

# Check if URL is empty
if [ -z "$url" ]; then
    echo "No URL provided. Exiting."
    exit 1
fi

# Download the airgap bundle to a local file (bundle is ~15GB+)
echo "Downloading airgap bundle to ${BUNDLE_FILE} ..."
curl -fSL -o "$BUNDLE_FILE" "$url"

# Extract the bundle
echo "Extracting to ${BUNDLE_DIR}/ ..."
mkdir -p "$BUNDLE_DIR"
tar xzf "$BUNDLE_FILE" -C "$BUNDLE_DIR"


# Show what was extracted
echo ""
echo "Airgap bundle contents:"
ls -lh "$BUNDLE_DIR"/

echo ""
echo "Bundle files are in ${BUNDLE_DIR}/ — use 'nkp push bundle' to seed your private registry."
